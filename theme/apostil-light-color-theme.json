  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a877f", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#8a5a2b" }
    },
    {
      "name": "Regular expressions and escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#9a4a1f" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language"],
      "settings": { "foreground": "#5b4b8a" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#31423b" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#9a4a1f" }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "#7a3e65" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": { "foreground": "#0b5f58" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#2f5d7c" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#5b4b8a" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#0b5f58" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#31423b" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#7a3e65" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#0b5f58", "fontStyle": "bold" }
    },
    {
      "name": "Markup emphasis",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup strong",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#0b5f58" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#8a5a2b" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#047857" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#b42318" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b42318" }
    }
  ]
}
