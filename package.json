{
  "name": "apostil",
  "displayName": "Apostil",
  "description": "Review a change from a coding agent as parts, notes and diagrams that point at the code.",
  "version": "0.4.4",
  "private": true,
  "publisher": "apostil",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Albertsteenstrup/apostil.git"
  },
  "bugs": {
    "url": "https://github.com/Albertsteenstrup/apostil/issues"
  },
  "icon": "view/media/apostil-icon.png",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=24"
  },
  "main": "./out/view/extension.js",
  "bin": {
    "apostil": "./out/store/cli.js",
    "apostil-helper": "./out/helper/helper.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && APOSTIL_AGENT_HOME=out/no-agent-home node --test \"out/**/*.test.js\"",
    "check": "node view/check.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --readme-path skills/README.md",
    "check-package": "node out/view/package-check.js",
    "vscode:uninstall": "node ./out/store/uninstall-hook.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apostil",
          "title": "Apostil",
          "icon": "view/media/apostil.svg"
        }
      ]
    },
    "views": {
      "apostil": [
        {
          "type": "webview",
          "id": "apostil.changes",
          "name": "Repo",
          "initialSize": 1
        },
        {
          "id": "apostil.files",
          "name": "Files",
          "initialSize": 4
        },
        {
          "id": "apostil.look",
          "name": "Look",
          "when": "apostil.lookList",
          "initialSize": 2
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "apostil.file",
        "displayName": "Apostil: the change in this file",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "apostil.openChange",
        "title": "Apostil: Open the newest change"
      },
      {
        "command": "apostil.remark",
        "title": "Apostil: Add a comment"
      },
      {
        "command": "apostil.sortAndFilter",
        "title": "Apostil: Sort and Filter the Changes"
      },
      {
        "command": "apostil.refresh",
        "title": "Apostil: Load the changes again"
      },
      {
        "command": "apostil.chooseLook",
        "title": "Apostil: Choose a look"
      },
      {
        "command": "apostil.installCommand",
        "title": "Apostil: Install the apostil command"
      },
      {
        "command": "apostil.connectClaudeCode",
        "title": "Apostil: Connect Claude Code"
      },
      {
        "command": "apostil.setUp",
        "title": "Apostil: Set up for agents"
      },
      {
        "command": "apostil.uninstall",
        "title": "Apostil: Uninstall…"
      },
      {
        "command": "apostil.openPullRequest",
        "title": "Apostil: Open pull request…"
      },
      {
        "command": "apostil.reportIssue",
        "title": "Apostil: Report an Issue"
      },
      {
        "command": "apostil.home",
        "title": "Apostil: Home",
        "icon": "view/media/apostil.svg"
      },
      {
        "command": "apostil.graphsOf",
        "title": "Apostil: Graphs of this folder or file",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "apostil.toggleNotes",
        "title": "Apostil: Hide or show the notes of this tab"
      },
      {
        "command": "apostil.openNoteInTab",
        "title": "Apostil: Open a note in the file tab"
      },
      {
        "command": "apostil.openBranchChange",
        "title": "Open the change in Apostil",
        "category": "Apostil",
        "icon": "view/media/apostil.svg"
      },
      {
        "command": "apostil.linksOff",
        "title": "Apostil: Turn off links and nudges"
      },
      {
        "command": "apostil.linksOn",
        "title": "Apostil: Turn on links and nudges"
      },
      {
        "command": "apostil.openLookPage",
        "title": "Apostil: Open a Page of the Look…"
      },
      {
        "command": "apostil.openNoteOnHome",
        "title": "Open This Note on Home",
        "category": "Apostil"
      },
      {
        "command": "apostil.showProcessOfLine",
        "title": "Show the Process of This Line",
        "category": "Apostil"
      },
      {
        "command": "apostil.showPlacesOfMark",
        "title": "Show the Other Places of This Mark",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookActions",
        "title": "Actions of the Look…",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction1",
        "title": "Run Action 1 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction2",
        "title": "Run Action 2 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction3",
        "title": "Run Action 3 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction4",
        "title": "Run Action 4 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction5",
        "title": "Run Action 5 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction6",
        "title": "Run Action 6 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction7",
        "title": "Run Action 7 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction8",
        "title": "Run Action 8 of the Look",
        "category": "Apostil"
      },
      {
        "command": "apostil.lookAction9",
        "title": "Run Action 9 of the Look",
        "category": "Apostil"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "apostil.graphsOf",
          "when": "view == apostil.files && viewItem == apostil.inDiagram",
          "group": "inline"
        },
        {
          "command": "apostil.lookActions",
          "when": "view == apostil.files && apostil.lookMenu.actions.explorer",
          "group": "apostil@1"
        }
      ],
      "explorer/context": [
        {
          "command": "apostil.graphsOf",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        },
        {
          "command": "apostil.lookActions",
          "when": "apostil.lookMenu.actions.explorer",
          "group": "apostil@1"
        }
      ],
      "editor/title": [
        {
          "command": "apostil.graphsOf",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "scm/title": [
        {
          "command": "apostil.openBranchChange",
          "when": "scmProvider == git && !apostil.linksOff",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "apostil.openNoteInTab",
          "when": "false"
        },
        {
          "command": "apostil.linksOff",
          "when": "!apostil.linksOff"
        },
        {
          "command": "apostil.linksOn",
          "when": "apostil.linksOff"
        },
        {
          "command": "apostil.openLookPage",
          "when": "apostil.lookHasPages"
        },
        {
          "command": "apostil.openNoteOnHome",
          "when": "apostil.lookEntry.note"
        },
        {
          "command": "apostil.showProcessOfLine",
          "when": "apostil.lookEntry.process"
        },
        {
          "command": "apostil.showPlacesOfMark",
          "when": "apostil.lookEntry.mark"
        },
        {
          "command": "apostil.lookActions",
          "when": "apostil.lookEntry.actions"
        },
        {
          "command": "apostil.lookAction1",
          "when": "false"
        },
        {
          "command": "apostil.lookAction2",
          "when": "false"
        },
        {
          "command": "apostil.lookAction3",
          "when": "false"
        },
        {
          "command": "apostil.lookAction4",
          "when": "false"
        },
        {
          "command": "apostil.lookAction5",
          "when": "false"
        },
        {
          "command": "apostil.lookAction6",
          "when": "false"
        },
        {
          "command": "apostil.lookAction7",
          "when": "false"
        },
        {
          "command": "apostil.lookAction8",
          "when": "false"
        },
        {
          "command": "apostil.lookAction9",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "apostil.openNoteOnHome",
          "when": "apostil.lookMenu.note.editor && apostil.fileHas.note && resourceScheme == file",
          "group": "apostil@1"
        },
        {
          "command": "apostil.showProcessOfLine",
          "when": "apostil.lookMenu.process.editor && apostil.fileHas.process && resourceScheme == file",
          "group": "apostil@2"
        },
        {
          "command": "apostil.showPlacesOfMark",
          "when": "apostil.lookMenu.mark.editor && apostil.fileHas.mark && resourceScheme == file",
          "group": "apostil@3"
        },
        {
          "command": "apostil.lookActions",
          "when": "apostil.lookMenu.actions.editor",
          "group": "apostil@4"
        }
      ],
      "webview/context": [
        {
          "command": "apostil.openNoteOnHome",
          "when": "webviewId == 'apostil.file' && webviewSection == 'codeLine' && apostil.lookMenu.note.fileTab",
          "group": "apostil@1"
        },
        {
          "command": "apostil.showProcessOfLine",
          "when": "webviewId == 'apostil.file' && webviewSection == 'codeLine' && apostil.lookMenu.process.fileTab",
          "group": "apostil@2"
        },
        {
          "command": "apostil.showPlacesOfMark",
          "when": "webviewId == 'apostil.file' && webviewSection == 'codeLine' && apostil.lookMenu.mark.fileTab",
          "group": "apostil@3"
        },
        {
          "command": "apostil.lookActions",
          "when": "webviewId == 'apostil.file' && webviewSection == 'codeLine' && apostil.lookMenu.actions.fileTab",
          "group": "apostil@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "apostil.remark",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "apostil.pointerOnPage || activeWebviewPanelId == 'apostil.change' || activeWebviewPanelId == 'apostil.home' || activeCustomEditorId == 'apostil.file' || apostil.hasChange && editorTextFocus && editorHasSelection"
      },
      {
        "command": "apostil.remark",
        "key": "ctrl+shift+[Period]",
        "mac": "cmd+shift+[Period]",
        "when": "apostil.pointerOnPage || activeWebviewPanelId == 'apostil.change' || activeWebviewPanelId == 'apostil.home' || activeCustomEditorId == 'apostil.file' || apostil.hasChange && editorTextFocus && editorHasSelection"
      },
      {
        "command": "apostil.toggleNotes",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,",
        "when": "apostil.notesHere && (editorTextFocus || notebookEditorFocused || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.toggleNotes",
        "key": "ctrl+shift+[Comma]",
        "mac": "cmd+shift+[Comma]",
        "when": "apostil.notesHere && (editorTextFocus || notebookEditorFocused || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.openNoteOnHome",
        "key": "ctrl+alt+h",
        "when": "isMac && apostil.lookKey.note && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.showProcessOfLine",
        "key": "ctrl+alt+s",
        "when": "isMac && apostil.lookKey.process && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.showPlacesOfMark",
        "key": "ctrl+alt+m",
        "when": "isMac && apostil.lookKey.mark && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookActions",
        "key": "ctrl+alt+l",
        "when": "isMac && apostil.lookKey.actions && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction1",
        "key": "ctrl+alt+1",
        "when": "isMac && apostil.lookKey.action1 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction2",
        "key": "ctrl+alt+2",
        "when": "isMac && apostil.lookKey.action2 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction3",
        "key": "ctrl+alt+3",
        "when": "isMac && apostil.lookKey.action3 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction4",
        "key": "ctrl+alt+4",
        "when": "isMac && apostil.lookKey.action4 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction5",
        "key": "ctrl+alt+5",
        "when": "isMac && apostil.lookKey.action5 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction6",
        "key": "ctrl+alt+6",
        "when": "isMac && apostil.lookKey.action6 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction7",
        "key": "ctrl+alt+7",
        "when": "isMac && apostil.lookKey.action7 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction8",
        "key": "ctrl+alt+8",
        "when": "isMac && apostil.lookKey.action8 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      },
      {
        "command": "apostil.lookAction9",
        "key": "ctrl+alt+9",
        "when": "isMac && apostil.lookKey.action9 && (editorTextFocus || activeCustomEditorId == 'apostil.file')"
      }
    ],
    "themes": [
      {
        "id": "Apostil Light",
        "label": "Apostil Light",
        "uiTheme": "vs",
        "path": "./theme/apostil-light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Apostil",
      "properties": {
        "apostil.homeWhenEmpty": {
          "type": "boolean",
          "default": true,
          "description": "Open Apostil Home when a window on a Git repo has no open tab, in place of the empty editor area. When the look of the repo has a first page, that page opens instead, and once when the window starts. Off: Apostil opens nothing by itself, also not the first page."
        },
        "apostil.claudeModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "The model that a new Claude Code session for a comment starts on, until you choose another in the line of the model under the picker of the comment. The small model `haiku` by default. A session that a comment continues keeps the model it last used. The map and a description do not use it: their lead runs on the second smallest model at medium effort, unless you choose another in the line after their press, and every writer on the smallest at medium effort. Leave it empty to use the model of your Claude Code settings."
        },
        "apostil.codexModel": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "The model that a new Codex session for a comment starts on, until you choose another in the line of the model under the picker of the comment. The small model `gpt-6-luna` by default. A session that a comment continues keeps the model it last used. The map and a description do not use it: their lead runs on the second smallest model at medium effort, unless you choose another in the line after their press, and every writer on the smallest at medium effort. Leave it empty to use the model of your Codex settings. Set another when the command-line Codex refuses that model for your account."
        },
        "apostil.antigravityModel": {
          "type": "string",
          "default": "gemini-4-hydrogen",
          "markdownDescription": "The model that a new Antigravity session for a comment starts on, until you choose another in the line of the model under the picker of the comment. `gemini-4-hydrogen` by default. A session that a comment continues keeps the model it last used. The map and a description use `gemini-4-hydrogen` at medium effort for both lead and writers by default, unless you choose another lead in the line after their press. Leave it empty to use the model of your Antigravity settings."
        },
        "apostil.commentRuns": {
          "type": "string",
          "default": "read and edit",
          "enum": [
            "read and edit",
            "read only"
          ],
          "enumDescriptions": [
            "A run that a comment starts reads the repo and may change files, for a comment that asks for a change.",
            "A run that a comment starts reads the repo and changes nothing."
          ],
          "markdownDescription": "What a Claude Code run that a comment starts may do in your repo. With `read and edit` it may read and edit files, and run only the `apostil` command. A Codex run keeps the sandbox of your Codex settings."
        },
        "apostil.notesBesideCode": {
          "type": "string",
          "default": "tab",
          "enum": [
            "tab",
            "editor",
            "off"
          ],
          "enumDescriptions": [
            "A file that has notes opens in the file tab of Apostil by itself: the code, with each note as a card beside its lines. Cmd+Shift+, changes that tab to the editor of VS Code and back. A notebook stays in its own editor, with its notes in its cells.",
            "The compact way. The notes stand in the editor of VS Code: the title of each note after a line of its code, a thin line at the left of its lines, and the whole note under the pointer.",
            "No notes beside the code, until you switch them on again."
          ],
          "markdownDescription": "Where the notes of Apostil stand when a code file opens the normal way. Cmd+Shift+, (Ctrl+Shift+,) takes the notes of one tab away and brings them back; the next file opens with its notes."
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Apostil Light"
    },
    "colors": [
      {
        "id": "apostil.noteLine",
        "description": "The thin line at the left of the lines of the note under the pointer.",
        "defaults": {
          "light": "#0f766e",
          "dark": "#3fb5a8",
          "highContrast": "#5eead4",
          "highContrastLight": "#0f766e"
        }
      },
      {
        "id": "apostil.noteTitle",
        "description": "The quiet title of a note at the end of its first line.",
        "defaults": {
          "light": "#5f817b",
          "dark": "#7fa9a2",
          "highContrast": "#ffffff",
          "highContrastLight": "#000000"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
